// Particle Explosion Effects Configuration
// Controls one-shot burst effects like explosions, impacts, and spawns
//
// Gradient format: list of (time, value) where time is 0.0-1.0 (particle lifetime fraction)
// color_gradient: (time, (R, G, B, A)) where RGBA are 0.0-1.0
// size_gradient: (time, size) where size is in world units
(
    effects: {
        // Fire explosion - bright flames that fade to embers
        "fire": (
            color_gradient: [
                (0.0, (1.0, 1.0, 0.6, 1.0)),   // Bright yellow-white core
                (0.15, (1.0, 0.8, 0.2, 1.0)),  // Yellow
                (0.4, (1.0, 0.4, 0.1, 1.0)),   // Orange
                (0.7, (0.9, 0.2, 0.05, 0.8)),  // Red-orange
                (1.0, (0.3, 0.1, 0.05, 0.0)),  // Dark embers, fade out
            ],
            size_gradient: [
                (0.0, 0.08),
                (0.3, 0.15),
                (0.7, 0.1),
                (1.0, 0.0),
            ],
            particle_count: 300.0,
            speed: 12.0,
            lifetime: 0.9,
            spawn_radius: 0.5,
            drag: 3.0,
            gravity: (0.0, -8.0, 0.0),
            circle_spawn: false,
            spawn_offset: (0.0, 0.0, 0.0),
